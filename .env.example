APP_NAME="EcoShare"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-ecoshare-domain.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Base de datos (Supabase / PostgreSQL) ───────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=aws-0-us-west-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DB_PASSWORD

# ─── Sesión y Cola ────────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

# ─── IA Análisis Eco (ODS 12) ─────────────────────────────────────────────────
# API compatible OpenAI — POST {ECO_ANALYSIS_AI_BASE_URL}/chat/completions
ECO_ANALYSIS_AI_API_KEY=
ECO_ANALYSIS_AI_BASE_URL=https://api.openai.com/v1
ECO_ANALYSIS_AI_MODEL=gpt-4o-mini
ECO_ANALYSIS_AI_TIMEOUT=90

# ─── Moderación de contenido ──────────────────────────────────────────────────
CONTENT_MODERATION_AI_API_KEY=
CONTENT_MODERATION_AI_BASE_URL=https://api.openai.com/v1
CONTENT_MODERATION_AI_MODEL=gpt-4o-mini
CONTENT_MODERATION_AI_TIMEOUT=45

# ─── Correo ───────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@ecoshare.app"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Reverb (WebSockets) ──────────────────────────────────────────────────────
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── AWS S3 (opcional, para fotos en producción) ──────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Imagen ───────────────────────────────────────────────────────────────────
IMAGE_DRIVER=gd
PROFILE_PHOTO_WEBP_QUALITY=78

# ─── Monitoreo ────────────────────────────────────────────────────────────────
HEALTH_TOKEN=
FORCE_HTTPS=true

VITE_APP_NAME="${APP_NAME}"
